{
	"name": "txms-server",
	"version": "1.4.0",
	"description": "TxMS server",
	"main": "src/server.ts",
	"engines": {
		"bun": ">=1.3.14"
	},
	"packageManager": "bun@1.3.14",
	"type": "module",
	"scripts": {
		"start": "bun run src/server.ts",
		"dev": "bun --watch run src/server.ts",
		"build": "bun build src/server.ts --target=bun --outdir=dist",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DataLayerHost/txms-server.git"
	},
	"keywords": [
		"txms",
		"server",
		"blockchain",
		"transaction",
		"core",
		"api",
		"blockindex",
		"blockbook"
	],
	"author": "DataLayer",
	"license": "CORE",
	"bugs": {
		"url": "https://github.com/DataLayerHost/txms-server/issues"
	},
	"homepage": "https://github.com/DataLayerHost/txms-server#readme",
	"dependencies": {
		"hono": "^4.13.2",
		"txms.js": "^1.3.8"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"typescript": "^7.0.2"
	}
}
