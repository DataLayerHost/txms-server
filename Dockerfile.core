FROM oven/bun:1.3.14-alpine AS dependencies

WORKDIR /usr/src/app

COPY package.json ./
RUN bun install --production --no-save

FROM alpine:3.22 AS gocore

ARG TARGETARCH
ARG GOCORE_VERSION=2.2.2

RUN apk add --no-cache ca-certificates curl \
	&& case "$TARGETARCH" in \
		amd64) asset_arch=x86_64 ;; \
		arm64) asset_arch=arm64 ;; \
		*) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
	esac \
	&& asset="gocore-linux-${asset_arch}" \
	&& release_url="https://github.com/core-coin/go-core/releases/download/v${GOCORE_VERSION}" \
	&& curl --fail --location --silent --show-error "$release_url/$asset" --output "/tmp/$asset" \
	&& curl --fail --location --silent --show-error "$release_url/$asset.checksum" --output "/tmp/$asset.checksum" \
	&& cd /tmp \
	&& sha256sum --check "$asset.checksum" \
	&& install -m 0755 "$asset" /usr/local/bin/gocore

FROM oven/bun:1.3.14-alpine

USER root
RUN apk add --no-cache caddy gcompat

WORKDIR /usr/src/app

ENV PORT=8080 \
	CORE_DATA_DIR=/var/lib/gocore \
	CORE_NETWORK=mainnet \
	CORE_HTTP_PORT=8545 \
	PROVIDER_TYPE=rpc \
	RPC_URL=http://127.0.0.1:8545 \
	RPC_METHOD=xcb_sendRawTransaction \
	XDG_CONFIG_HOME=/config \
	XDG_DATA_HOME=/data

COPY --from=dependencies /usr/src/app/node_modules ./node_modules
COPY --from=gocore /usr/local/bin/gocore /usr/local/bin/gocore
COPY package.json ./
COPY src ./src
COPY --chmod=0755 docker/start-core.sh /usr/local/bin/start-core
COPY Caddyfile /etc/caddy/Caddyfile

RUN mkdir -p /var/lib/gocore

VOLUME ["/var/lib/gocore", "/data", "/config"]

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
	CMD wget --quiet --spider http://127.0.0.1:8080/ping || exit 1

STOPSIGNAL SIGTERM

CMD ["/usr/local/bin/start-core"]
